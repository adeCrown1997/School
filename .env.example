# ===========================================================================
#  University ePortal — environment template (Phase 1)
#  Copy to `.env` and fill real values. NEVER commit the real `.env`.
# ===========================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
# Public origin of the web app, used for CORS + reset/activation links.
WEB_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL 16+) ---------------------------------------------
# The application connects as a LEAST-PRIVILEGE role (not the postgres superuser).
# See docs/28-DEV-SETUP for role creation. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://eportal_app:CHANGE_ME@127.0.0.1:5432/eportal?schema=public
# Superuser/DDL connection used ONLY for migrations + installing DB guards.
DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/eportal?schema=public

# --- JWT / sessions --------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_generate_48_random_bytes
JWT_ACCESS_TTL=900              # access token lifetime, seconds (15 min)
REFRESH_TOKEN_TTL_DAYS=7        # refresh token lifetime, days
# Cookies are Secure in production; set true when served over HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# --- Password / activation policy -----------------------------------------
PASSWORD_MIN_LENGTH=12
ACTIVATION_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=30
OTP_TTL_MINUTES=10
MAX_ACTIVATION_ATTEMPTS=5

# --- Bootstrap super administrator (seed reads these; never hardcoded) -----
# The seed provisions exactly one SUPER_ADMIN from these values, then you
# should rotate the password on first login.
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
BOOTSTRAP_ADMIN_NAME=System Administrator

# --- Rate limiting ---------------------------------------------------------
# Phase 1 uses in-process throttling. For horizontal scale, back this with
# Redis (see blueprint §16); REDIS_URL is read only if present.
# REDIS_URL=redis://127.0.0.1:6379

# --- Object storage (profile photos) --------------------------------------
# Phase 1 default: local disk. Swap for S3-compatible storage in production.
UPLOAD_DRIVER=local
UPLOAD_LOCAL_DIR=./uploads
